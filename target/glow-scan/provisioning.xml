<?xml version='1.0' encoding='UTF-8'?>

<installation xmlns="urn:jboss:galleon:provisioning:4.0">
    <feature-pack location="org.wildfly:wildfly-galleon-pack:39.0.1.Final">
        <default-configs inherit="false"/>
        <packages inherit="false"/>
    </feature-pack>
    <config model="standalone" name="standalone.xml">
        <layers>
            <include name="ee-core-profile-server"/>
            <include name="jaxrs"/>
            <include name="h2-driver"/>
            <include name="ejb-lite"/>
            <include name="jpa"/>
            <include name="jsf"/>
        </layers>
    </config>
    <options>
        <option name="jboss-fork-embedded" value="true"/>
        <option name="optional-packages" value="passive+"/>
    </options>
</installation>